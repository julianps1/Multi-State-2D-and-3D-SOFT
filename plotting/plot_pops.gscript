# Plot Correlation Funciton
# Output: png file

##########################
# Output settings
##########################

set terminal pngcairo enhanced color font 'Times-New-Roman,20'
set output "output/Populations.png"

##########################
# Labels and styling
##########################
set xlabel "Time (Dau)"
set ylabel "Population"
set title "State Populations"
#set grid
#unset key
#set yrange[0:0.15]
#set xrange[0:200]

##########################
# Line styles
##########################
set style line 1 lc rgb "red" lw 3 dashtype solid # Real
set style line 2 lc rgb "blue" lw 3 dashtype solid # Imaginary
set style line 3 lc rgb "black" lw 2 dashtype "-" # Total

##########################
# Plot
##########################
plot \
    "output/populations.dat" using 1:2 with lines ls 1 title "D_0",\
    "output/populations.dat" using 1:3 with lines ls 2 title "D_1",\
    "output/populations.dat" using 1:($2+$3) with lines ls 3 title "Total"

set output "output/AdiPopulations.png"
set title "Adiabatic Populations"
plot \
    "output/adipopulations.dat" using 1:2 with lines ls 1 title "S_0",\
    "output/adipopulations.dat" using 1:3 with lines ls 2 title "S_1",\
    "output/adipopulations.dat" using 1:($2+$3) with lines ls 3 title "Total"

##########################
# Finish output
##########################
unset output
