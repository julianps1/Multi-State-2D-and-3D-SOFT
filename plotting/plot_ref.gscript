# input file passed from command line
file = ARG1
base = substr(file,1,strlen(file)-4)

set terminal pngcairo size 800,600
set xlabel "x"
set ylabel "y"
set view map
set size ratio -1
set pm3d map
set palette rgb 21,22,23
set colorbox
set cblabel "|ψ|^2"
set title "Reaction Reference" 
#set logscale cb
#set cbrange [0:1e-3]


# Psi Ref 
set output sprintf("%s.png", base)
splot file using 1:2:4 with pm3d 