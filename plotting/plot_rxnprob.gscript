# Plot Correlation Funciton
# Output: png file

##########################
# Output settings
##########################

set terminal pngcairo enhanced color font 'Times-New-Roman,20'
set output "output/ReactionProb.png"

##########################
# Labels and styling
##########################
set xlabel "Time (Dau)"
set ylabel "Rxn Prob"
set title "Reaction Probability"
#set grid
#unset key
#set yrange[0:0.15]
#set xrange[0:200]

##########################
# Line styles
##########################
set style line 1 lc rgb "red" lw 3 dashtype solid # Real

##########################
# Plot
##########################
plot \
    "output/RxnProb.dat" using 1:(1-$2) with lines ls 1 notitle 

set title "Survival Probability"
set ylabel "Survival"
set output "output/SurvivalProb.png"
plot \
    "output/RxnProb.dat" using 1:2 with lines ls 1 notitle

##########################
# Finish output
##########################
unset output
