# input file passed from command line
file = ARG1
base = substr(file,1,strlen(file)-4)
input_file = "INq"

dt = real(system(sprintf("awk '$1==\"dt\" {print $2}' %s", input_file)))
tsub = real(system(sprintf("awk '$1==\"tsub\" {print $2}' %s", input_file)))
nwpackets = real(system(sprintf("awk '$1==\"nwpackets\" {print $2}' %s", input_file)))
dtsub = dt/tsub

snapshot_str = substr(base, 21, strlen(base))
snapshot_idx = real(snapshot_str)

if (snapshot_idx == 0) {
    t = 0.0
} else {
    t = (1.0 + (snapshot_idx - 1.0) * nwpackets) * tsub * dtsub
}

set terminal pngcairo size 800,600 font 'Times-New-Roman,14'
set xlabel "x"
set ylabel "y"
set view map
set pm3d map
set palette rgb 21,22,23
set colorbox
set cblabel "|ψ|^2"
set title sprintf("t = %.6g Dau", t)
unset key
#set logscale cb
#set cbrange [0:1e-3]


# state 1
set output base."_state0.png"
splot file using 1:2:3 with pm3d notitle

# state 2
set output base."_state1.png"
splot file using 1:2:4 with pm3d notitle
