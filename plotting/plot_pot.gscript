# input file passed from command line
file = "output/v_0.dat" 
base = substr(file,1,strlen(file)-4)

set terminal pngcairo size 800,600
set xlabel "x"
set ylabel "y"
set view map
set size ratio -1
set pm3d map
set palette rgb 33,13,10
set colorbox
set cblabel "V"
#set cbrange [0:1e-3]

set output "output/theta.png"
set title "v12"
splot "output/theta.dat" u 1:2:3 with pm3d

set output "output/RxnWeight.png"
set title "Weights"
splot "output/RxnWeight.dat" u 1:2:3 with pm3d

# list of columns and names
cols = "3 4 5 6 7 8 9 10 11"
names = "V00 V11 V01 vd0_real vd0_imag vd1_real vd1_imag vcos vsin"

do for [i=1:words(cols)] {

    col = int(word(cols,i))
    name = word(names,i)

    set output base . "_" . name . ".png"
    set title name

    splot file using 1:2:col with pm3d
}